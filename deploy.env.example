# نشر Medify على Oracle Cloud — انسخ إلى deploy.env واملأ القيم ثم:
#   bash infra/deploy/oracle.sh
ORACLE_HOST=            # عنوان IP العام للخادم (إلزامي)
ORACLE_USER=ubuntu      # يجرَّب opc تلقائياً إن فشل
ORACLE_SSH_KEY=~/.ssh/id_rsa
# اختياري:
DOMAIN=                 # وجود دومين = TLS تلقائي عبر Caddy
ANTHROPIC_API_KEY=      # غيابه = LLM_ENGINE=mock (يعمل كل شيء بعينات تجريبية)
# جيميناي — تفريغ حي (STT_ENGINE=gemini) + تلخيص/إرشاد (LLM_ENGINE=gemini) بمفتاح واحد.
# وجود المفتاح وحده يكفي: السكربت يختار gemini للمحركين تلقائياً (غيابه = mock بلا توقف).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# STT_ENGINE=              # gemini | whisper | mock — يتجاوز الاختيار التلقائي
# LLM_ENGINE=              # gemini | claude | mock — يتجاوز الاختيار التلقائي
REPO_URL=https://github.com/pharmjeed/medifyy11.git
GIT_REF=v0.1.0
# منافذ قابلة للتخصيص (لخادم مشترك يشغل 80/443 لمشروع آخر):
# PROD_HTTP_PORT=80
# PROD_HTTPS_PORT=443
# STAGING_HTTP_PORT=8080
# STAGING_HTTPS_PORT=8443
